menu "WiFi Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) for the example to connect to.

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            WiFi password (WPA or WPA2) for the example to use.

    config ESP_MAXIMUM_RETRY
        int "Maximum retry"
        default 5
        help
            Set the Maximum retry to avoid station reconnecting to the AP unlimited when the AP is really inexistent.

endmenu

menu "VL53L0X Sensor Configuration"

    config VL53L0X_I2C_SDA_GPIO
        int "I2C SDA GPIO Number"
        range 0 50
        default 14
        help
            GPIO number for I2C SDA (data line).

    config VL53L0X_I2C_SCL_GPIO
        int "I2C SCL GPIO Number"
        range 0 50
        default 15
        help
            GPIO number for I2C SCL (clock line).

    config VL53L0X_I2C_CLOCK_SPEED_HZ
        int "I2C Clock Speed (Hz)"
        range 100000 1000000
        default 400000
        help
            I2C clock speed in Hz. Standard speeds: 100kHz, 400kHz, 1MHz.

    config VL53L0X_TIMING_BUDGET_MS
        int "Timing Budget (ms)"
        range 10 1000
        default 33
        help
            Measurement timing budget in milliseconds. Lower values = faster but less accurate.

    config VL53L0X_INTER_MEASUREMENT_PERIOD_MS
        int "Inter-Measurement Period (ms)"
        range 10 1000
        default 50
        help
            Time between measurements in milliseconds. Must be >= timing budget.

endmenu

