menu "Cabina Firmware Configuration"

config CABINA_WIFI_SSID
    string "Wi-Fi SSID"
    default "YourWiFiNetwork"

config CABINA_WIFI_PASSWORD
    string "Wi-Fi Password"
    default "YourWiFiPassword"

config CABINA_MQTT_BROKER
    string "MQTT broker address"
    default "192.168.1.10"

config CABINA_MQTT_PORT
    int "MQTT port"
    default 1883

config CABINA_MQTT_USER
    string "MQTT username"
    default ""

config CABINA_MQTT_PASSWORD
    string "MQTT password"
    default ""

config CABINA_TOPIC_BASE
    string "MQTT topic base"
    default "parking"

config CABINA_SITE_ID
    string "Site ID"
    default "default-site"

config CABINA_DEVICE_ID
    string "Device ID (blank=derive from MAC)"
    default ""

config CABINA_PRESENCE_RETAIN
    bool "Retain presence messages"
    default y

config CABINA_PUB_INTERVAL_SEC
    int "Telemetry publish interval (seconds)"
    default 10
    range 1 3600

config CABINA_SAMPLE_PERIOD_MS
    int "Sensor sample period (ms)"
    default 50
    range 5 1000

config CABINA_DISTANCE_THRESHOLD_MM
    int "Distance change threshold for events (mm)"
    default 20
    range 5 200
    help
        Minimum distance change (in mm) required to trigger a distance event.
        Smaller values = more sensitive, larger values = less sensitive.
        Default 20mm matches CircuitPython implementation.

config CABINA_IR_PULLUPS
    bool "Enable internal pull-ups for IR inputs"
    default y

comment "Pin map - ESP32-S3"

config CABINA_S3_I2C_SCL
    int "ESP32-S3 I2C SCL pin"
    default 9
config CABINA_S3_I2C_SDA
    int "ESP32-S3 I2C SDA pin"
    default 8
config CABINA_S3_IR1_GPIO
    int "ESP32-S3 IR1 GPIO"
    default 2
config CABINA_S3_IR2_GPIO
    int "ESP32-S3 IR2 GPIO"
    default 3

comment "Pin map - ESP32-C6"

config CABINA_C6_I2C_SCL
    int "ESP32-C6 I2C SCL pin"
    default 15
config CABINA_C6_I2C_SDA
    int "ESP32-C6 I2C SDA pin"
    default 14
config CABINA_C6_IR1_GPIO
    int "ESP32-C6 IR1 GPIO"
    default 2
config CABINA_C6_IR2_GPIO
    int "ESP32-C6 IR2 GPIO"
    default 3

endmenu


