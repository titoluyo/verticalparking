menu "Example Configuration"

    choice EXAMPLE_HARDWARE
        prompt "Hardware"
        default EXAMPLE_HARDWARE_QTPY
        help
            Select the hardware to run this example on.

        config EXAMPLE_HARDWARE_QTPY
            bool "QtPy ESP32 Pico or QtPy ESP32-S3"

        config EXAMPLE_HARDWARE_CUSTOM
            bool "Custom"
    endchoice

    config EXAMPLE_I2C_SCL_GPIO
        int "SCL GPIO Num"
        range 0 50
        default 40 if EXAMPLE_HARDWARE_QTPY && IDF_TARGET_ESP32S3
        default 15 if EXAMPLE_HARDWARE_QTPY && IDF_TARGET_ESP32C6
        default 19 if EXAMPLE_HARDWARE_QTPY && IDF_TARGET_ESP32
        default 19 if EXAMPLE_HARDWARE_CUSTOM
        help
            GPIO number for I2C Master clock line.

    config EXAMPLE_I2C_SDA_GPIO
        int "SDA GPIO Num"
        range 0 50
        default 41 if EXAMPLE_HARDWARE_QTPY && IDF_TARGET_ESP32S3
        default 14 if EXAMPLE_HARDWARE_QTPY && IDF_TARGET_ESP32C6
        default 22 if EXAMPLE_HARDWARE_QTPY && IDF_TARGET_ESP32
        default 22 if EXAMPLE_HARDWARE_CUSTOM
        help
            GPIO number for I2C Master data line.

    config EXAMPLE_I2C_CLOCK_SPEED_HZ
        int "I2C Clock Speed"
        range 100 1000000
        default 400000
        help
            I2C clock speed in Hz.

    config EXAMPLE_WIFI_SSID
        string "Wi-Fi SSID"
        default "YourWiFiNetwork"
        help
            SSID (network name) for the Wi-Fi connection.

    config EXAMPLE_WIFI_PASSWORD
        string "Wi-Fi Password"
        default "YourWiFiPassword"
        help
            Password for the Wi-Fi network.

    config EXAMPLE_WIFI_MAX_RETRY
        int "Wi-Fi Maximum Connection Retries"
        range 1 20
        default 5
        help
            Maximum number of retry attempts when connecting to Wi-Fi.

    config EXAMPLE_MQTT_BROKER
        string "MQTT Broker Address"
        default "192.168.1.10"
        help
            MQTT broker hostname or IP address.

    config EXAMPLE_MQTT_PORT
        int "MQTT Broker Port"
        range 1 65535
        default 1883
        help
            MQTT broker port number.

    config EXAMPLE_MQTT_USER
        string "MQTT Username"
        default ""
        help
            MQTT username (leave empty if no authentication required).

    config EXAMPLE_MQTT_PASSWORD
        string "MQTT Password"
        default ""
        help
            MQTT password (leave empty if no authentication required).

    config EXAMPLE_MQTT_TOPIC_BASE
        string "MQTT Topic Base"
        default "parking"
        help
            Base topic for MQTT messages. Full topic will be: {base}/{site_id}/{device_id}/{subtopic}

    config EXAMPLE_MQTT_SITE_ID
        string "MQTT Site ID"
        default "default-site"
        help
            Site identifier for MQTT topic construction.

    config EXAMPLE_MQTT_DEVICE_ID
        string "MQTT Device ID"
        default "cabina-01"
        help
            Device identifier for MQTT topic construction.

    config EXAMPLE_IR1_GPIO
        int "IR Sensor 1 GPIO Pin"
        range 0 50
        default 2
        help
            GPIO pin number for IR presence sensor 1.

    config EXAMPLE_IR2_GPIO
        int "IR Sensor 2 GPIO Pin"
        range 0 50
        default 3
        help
            GPIO pin number for IR presence sensor 2.

    config EXAMPLE_IR_PULLUPS
        bool "Enable pull-ups for IR sensors"
        default y
        help
            Enable internal pull-ups for IR sensor inputs. If enabled, high level means presence detected.
            If disabled, low level means presence detected.

    config EXAMPLE_DISTANCE_THRESHOLD_MM
        int "Distance Change Threshold (mm)"
        range 5 200
        default 20
        help
            Minimum distance change (in mm) required to trigger a distance event.
            Smaller values = more sensitive, larger values = less sensitive.

    config EXAMPLE_PRESENCE_RETAIN
        bool "Retain presence messages"
        default y
        help
            Whether to retain IR presence messages on MQTT broker.

    config EXAMPLE_STATUS_INTERVAL_SEC
        int "Status Heartbeat Interval (seconds)"
        range 1 3600
        default 10
        help
            Interval for publishing status heartbeat messages to MQTT.

    menu "OTA Update Configuration"
        config EXAMPLE_OTA_VALIDATION_TIMEOUT_SEC
            int "OTA Validation Timeout (seconds)"
            range 10 300
            default 60
            help
                Time in seconds after boot to validate firmware after OTA update.
                If validation is not confirmed within this time, the device will
                rollback to the previous firmware version.

        config EXAMPLE_OTA_SKIP_CERT_VERIFY
            bool "Skip HTTPS certificate verification (development only)"
            default n
            help
                Skip certificate verification for HTTPS OTA downloads.
                WARNING: Only enable for development/testing. Insecure for production!

        config EXAMPLE_OTA_AUTO_VALIDATE
            bool "Auto-validate firmware after successful init"
            default y
            help
                Automatically mark firmware as valid after successful initialization.
                If disabled, the application must explicitly call ota_update_mark_valid().

        config EXAMPLE_OTA_VERSION_PUBLISH_ON_BOOT
            bool "Publish firmware version on boot"
            default y
            help
                Publish the current firmware version to MQTT when the device boots.
    endmenu

endmenu
