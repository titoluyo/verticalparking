# Don't set target here - use idf.py set-target instead
# CONFIG_IDF_TARGET handled by set-target command

CONFIG_FREERTOS_HZ=1000

# set compiler optimization level to -O2 (compile for performance)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# CPU frequency - 160MHz max for ESP32-C6
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# Common ESP-related
#
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Set esp-timer task stack size to 6KB
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144

# Flash size - 4MB for most ESP32-C6/S3 boards
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom Partition Table with larger OTA partitions (1.75MB each)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Bootloader - Enable app rollback for OTA safety
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# OTA Configuration
CONFIG_EXAMPLE_OTA_VALIDATION_TIMEOUT_SEC=60
CONFIG_EXAMPLE_OTA_SKIP_CERT_VERIFY=n
CONFIG_EXAMPLE_OTA_AUTO_VALIDATE=y
CONFIG_EXAMPLE_OTA_VERSION_PUBLISH_ON_BOOT=y

# Allow HTTP (not just HTTPS) for OTA updates
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
